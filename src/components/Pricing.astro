---
import CtaButton from './CtaButton.astro';
import Icon from './Icon.astro';
import { buyLink } from '../lib/site.mjs';
const { site } = Astro.props;
const pr = site.pricing ?? {};
const plans = pr.plans ?? [];
const sec = pr.section ?? {};
const refundDays = site.refundDays ?? 7;
---
<section class="section" id="pricing">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">{sec.eyebrow ?? 'Тарифы'}</span>
      <h2>{sec.title ?? 'Чем дольше — тем выгоднее'}</h2>
      {(sec.sub ?? pr.note) && <p>{sec.sub ?? pr.note}</p>}
    </div>
    <div class="plans">
      {plans.map((p) => (
        <div class={`plan${p.badge ? ' plan-hl' : ''}`}>
          {p.badge && <span class="badge">{p.badge}</span>}
          <div class="name">{p.name}</div>
          <div class="price-row">
            <span class="price">{p.price}{p.period && <small>{p.period}</small>}</span>
            {p.old && <span class="old">{p.old}</span>}
            {p.save && <span class="save">{p.save}</span>}
          </div>
          {(p.priceNote || p.perDay) && (
            <div class="pday">{[p.priceNote, p.perDay].filter(Boolean).join(' · ')}</div>
          )}
          <div class="divider"></div>
          <ul>
            {p.features.map((feat) => (
              <li><Icon name="check" size={15} stroke={2.6} class="gold" />{feat}</li>
            ))}
          </ul>
          <CtaButton href={buyLink(site, p.slug)} label={p.cta ?? 'Выбрать'} variant={p.badge ? 'primary' : 'ghost'} />
        </div>
      ))}
    </div>
    {pr.guarantee !== false && (
      <div class="guarantee">
        <Icon name="shield-check" size={18} class="gold" />
        {pr.guaranteeText ?? `Гарантия возврата денег в течение ${refundDays} дней — без вопросов`}
      </div>
    )}
  </div>
</section>
<style>
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: stretch; }
  @media (max-width: 880px) { .plans { grid-template-columns: 1fr; max-width: 430px; margin-inline: auto; } }
  .plan { position: relative; display: flex; flex-direction: column; gap: 14px; background: var(--card); border: 1px solid var(--line-soft); border-radius: var(--radius); padding: 28px 24px; transition: border-color .25s, transform .25s; }
  .plan:hover { border-color: var(--line); transform: translateY(-3px); }
  .plan-hl { background: linear-gradient(180deg, var(--card-2), var(--card)); border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 22px 56px -30px var(--accent-glow); }
  .badge { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); background: var(--accent); color: #1a1405; font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; padding: 5px 13px; border-radius: 6px; white-space: nowrap; }
  .name { font-weight: 600; color: var(--muted-strong); font-family: var(--font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; }
  .price-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .price { font-size: 44px; font-weight: 800; line-height: 1; letter-spacing: -.03em; }
  .price small { font-size: 15px; font-weight: 500; color: var(--muted); margin-left: 4px; letter-spacing: 0; }
  .old { color: var(--muted); text-decoration: line-through; font-size: 18px; font-weight: 500; }
  .save { font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); border-radius: 6px; padding: 3px 8px; }
  .pday { font-size: 13px; color: var(--muted); margin-top: -6px; }
  ul { list-style: none; padding: 0; margin: 4px 0 0; display: grid; gap: 11px; }
  li { position: relative; padding-left: 26px; font-size: 14.5px; color: var(--fg); }
  li :global(svg) { position: absolute; left: 1px; top: 4px; }
  .plan :global(.btn) { margin-top: auto; width: 100%; }
  .guarantee { margin-top: 24px; display: flex; gap: 10px; align-items: center; justify-content: center; color: var(--muted-strong); font-size: 14px; text-align: center; }
</style>
