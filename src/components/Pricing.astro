---
import CtaButton from './CtaButton.astro';
import { buyLink } from '../lib/site.mjs';
const { site } = Astro.props;
const pr = site.pricing;
---
<section class="section" id="pricing">
  <div class="container">
    <h2 class="center">Тарифы</h2>
    {pr.note && <p class="center muted">{pr.note}</p>}
    <div class="grid cols-3" style="margin-top:28px">
      {pr.plans.map((p) => (
        <div class={`card plan${p.badge ? ' plan-hl' : ''}`}>
          {p.badge && <span class="badge">{p.badge}</span>}
          <h3>{p.name}</h3>
          <div class="price">{p.price}<span class="muted period">{p.period}</span></div>
          {p.priceNote && <div class="muted small">{p.priceNote}</div>}
          <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
          <CtaButton href={buyLink(site, p.slug)} label={p.cta} />
        </div>
      ))}
    </div>
    <p class="center muted small">Оплата и выдача ключа — на сайте, сразу после оплаты.</p>
  </div>
</section>
<style>
  .plan { display: flex; flex-direction: column; gap: 12px; position: relative; }
  .plan-hl { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
  .badge { position:absolute; top:-11px; right:18px; background:var(--accent); color:#07101f; font-size:12px; font-weight:700; padding:3px 10px; border-radius:999px; }
  .price { font-size: 32px; font-weight: 700; }
  .period { font-size: 15px; font-weight: 400; margin-left: 4px; }
  .plan ul { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 8px; }
  .plan li { padding-left: 22px; position: relative; color: var(--muted); }
  .plan li::before { content: "✓"; position: absolute; left: 0; color: var(--accent-2); font-weight: 700; }
  .plan .btn { margin-top: auto; }
  .small { font-size: 13px; }
</style>
