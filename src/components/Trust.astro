---
const { site } = Astro.props;
const reviews = site.trust?.reviews ?? [];
const r = site.reviewsSection ?? {};
---
{reviews.length > 0 && (
  <section class="section" id="reviews">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">{r.eyebrow ?? 'Отзывы'}</span>
        <h2>{r.title ?? 'Нам доверяют'}</h2>
      </div>
      <div class="grid cols-2">
        {reviews.map((rev) => (
          <figure class="card review">
            <div class="stars" aria-hidden="true">★★★★★</div>
            <blockquote>«{rev.text}»</blockquote>
            <figcaption>— {rev.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .review { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .review .stars { color: var(--accent); letter-spacing: 2px; font-size: 14px; }
  .review blockquote { margin: 0; font-size: 16px; color: var(--fg); line-height: 1.6; }
  .review figcaption { color: var(--muted); font-family: var(--font-mono); font-size: 12.5px; letter-spacing: .04em; }
</style>
