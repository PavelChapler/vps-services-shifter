---
const { href, label, variant = 'primary', size = '', external = false, class: cls = '' } = Astro.props;
const klass = ['btn', `btn-${variant}`, size && `btn-${size}`, cls].filter(Boolean).join(' ');
---
{external ? (
  <a class={klass} href={href} rel="nofollow" target="_blank">{label}</a>
) : (
  <a class={klass} href={href}>{label}</a>
)}
